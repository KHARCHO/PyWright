# Copy to .env and adjust per project / environment (.env is git-ignored)

# Application under test
BASE_URL=https://playwright.dev
API_BASE_URL=https://jsonplaceholder.typicode.com
DEFAULT_TIMEOUT_MS=10000
# true shows the browser window, false runs headless
HEADED=false
# Pause between actions in headed runs, in milliseconds
SLOW_MO_MS=500
# Comma-separated URL globs answered with an empty response (third-party scripts that hang page load)
# e.g. BLOCKED_URLS=**/*chat-widget.com/**,**/*ads.example.com/**
BLOCKED_URLS=

# Existing test account for signed-in tests; tests using user_credentials skip when empty
APP_USERNAME=
APP_PASSWORD=

# Qase reporting (optional) - uncomment to send results to Qase TestOps
# QASE_MODE=testops
# QASE_TESTOPS_PROJECT=YOUR_PROJECT_CODE
# QASE_TESTOPS_API_TOKEN=
